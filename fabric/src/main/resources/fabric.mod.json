{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/glow-ink-plus",
        "sources": "https://github.com/anviaan/GlowInkPlus",
        "issues": "https://github.com/anviaan/GlowInkPlus/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/glow-ink-plus",
                "modmenu.modrinth": "https://modrinth.com/mod/glow-ink-plus"
            }
        }
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.anvian.glow_ink_plus.GlowInkPlusFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=1.21.2",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  